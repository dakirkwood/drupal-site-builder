# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*~
.fuse_hidden*
.directory
.nfs*

# ---------------------------------------------------------------------------
# Editor / IDE cruft
# ---------------------------------------------------------------------------

# JetBrains (PhpStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
out/
/shelf/
/workspace.xml
/httpRequests/
/dataSources/
/dataSources.local.xml
/codestream.xml

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs / nano backup files
*.swp
*.swo
*.swn
*.bak
*.orig
*.rej
*~

# Eclipse
.project
.buildpath
.settings/

# NetBeans
nbproject/

# ---------------------------------------------------------------------------
# Dependency directories
# ---------------------------------------------------------------------------
vendor/
node_modules/
bower_components/

# ---------------------------------------------------------------------------
# Lock files — keep composer.lock OUT of a Drupal contrib/custom module
# (consumers pin their own dependency versions in their site composer.json)
# ---------------------------------------------------------------------------
composer.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---------------------------------------------------------------------------
# Build & tooling caches
# ---------------------------------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpcs-cache
.phpstan.cache/
phpstan-baseline.neon
.cache/

# Coverage reports
coverage/
build/coverage/
clover.xml
coverage.xml
*.coverage

# ---------------------------------------------------------------------------
# Environment & secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Build Spec test fixtures (private client data; live outside version control)
# ---------------------------------------------------------------------------
uwec_complete/
