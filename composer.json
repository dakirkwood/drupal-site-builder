{
  "name": "dakirkwood/drupal_site_builder",
  "description": "Provides a Drush command that imports site config from the Build Spec",
  "type": "drupal-custom-module",
  "minimum-stability": "dev",
  "license": "proprietary",
  "authors": [
    {
      "name": "David Kirkwood",
      "email": "david@electriccitizen.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "drupal/core": "^10 || ^11",
    "drupal/paragraphs": "^1",
    "drupal/pathauto": "^1.13",
    "league/csv": "^9"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "drupal/core-dev": "^10 || ^11",
    "mglaman/phpstan-drupal": "^1.2",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^1.12"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist",
    "phpstan": "phpstan analyse",
    "test": "phpunit"
  },
  "extra": {
    "drupal": {
      "package": "Custom"
    }
  }
}